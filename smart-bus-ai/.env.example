# Environment Configuration for AI Server

# Database Configuration (Optional - for fetching card data)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_bus_db

# AI Server Configuration
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8000

# Face Recognition Settings
FACE_RECOGNITION_TOLERANCE=0.6  # Lower = stricter (0.4-0.8)

# Vosk Model Path
VOSK_MODEL_PATH=models/vosk/vosk-model-small-en-us-0.15

# TTS Settings
TTS_RATE=150  # Speech rate
TTS_VOLUME=0.9  # Volume (0.0-1.0)

# Prediction Model Settings
PREDICTION_MODEL_PATH=models/ml/card_risk.pkl
PREDICTION_SCALER_PATH=models/ml/scaler.pkl

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# CORS Settings (Node.js backend and frontend)
CORS_ORIGINS=http://localhost:5000,http://localhost:5173
